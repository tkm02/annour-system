{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx lint-staged:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(rm:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",
      "Bash(npm run lint -- --fix:*)",
      "Bash(npx eslint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --force:*)",
      "Bash(git diff --output:*)",
      "Bash(git log --output:*)",
      "Bash(git show --output:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(cat .env.local:*)",
      "Bash(type .env.local:*)",
      "Bash(cat .env.development:*)",
      "Bash(type .env.development:*)",
      "Bash(cat .env.development.local:*)",
      "Bash(type .env.development.local:*)",
      "Bash(cat .env.production:*)",
      "Bash(type .env.production:*)",
      "Bash(cat .env.production.local:*)",
      "Bash(type .env.production.local:*)",
      "Bash(cat .env.test:*)",
      "Bash(type .env.test:*)",
      "Bash(cat .env.test.local:*)",
      "Bash(type .env.test.local:*)",
      "Bash(git diff --no-index:*)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./.env.prod)",
      "Read(./.env.preview)",
      "Read(**/.env.staging)",
      "Read(**/.env.staging.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.preview)",
      "Read(**/*.xlsx)",
      "Read(**/*.xls)",
      "Read(**/*.csv)",
      "Read(**/*.cms)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.mjs\""
          }
        ]
      }
    ]
  }
}
