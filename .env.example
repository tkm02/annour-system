# Copier en .env.local pour le développement. Ne jamais committer .env ou .env.local.
# Les variables NEXT_PUBLIC_* sont incluses dans le code envoyé au navigateur : n'y mettre aucun secret.

# URL de l'API backend (sans slash final). Sans valeur, l'API de production est utilisée.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Données de l'édition (facultatif) : par défaut, valeurs de lib/edition.ts. Exemple :
# NEXT_PUBLIC_EDITION_LIBELLE=8ème édition
# NEXT_PUBLIC_EDITION_DATES=20 au 25 décembre 2026
# NEXT_PUBLIC_EDITION_LIEU=Lycée Moderne de Cocody
# NEXT_PUBLIC_EDITION_ANNEE_SCOLAIRE=AnNour26
# Autres variables d'édition lues par lib/edition.ts (facultatives) :
# NEXT_PUBLIC_EDITION_NUMERO=8
# NEXT_PUBLIC_EDITION_VERSION=8.0
# NEXT_PUBLIC_EDITION_ANNEE=2026
# NEXT_PUBLIC_EDITION_DATE_CLOTURE=25 décembre 2026
# NEXT_PUBLIC_EDITION_VILLE=Cocody
# NEXT_PUBLIC_EDITION_ARRIVEE=Samedi 19 décembre à partir de 14h00
# NEXT_PUBLIC_EDITION_CONTACTS=<numéros de contact publics>
# NEXT_PUBLIC_EDITION_ANNEE_SCOLAIRE_LIBELLE=2025-2026
