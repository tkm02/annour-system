# Copier en .env.local pour le développement. Ne jamais committer .env ou .env.local.
# Les variables NEXT_PUBLIC_* sont incluses dans le code envoyé au navigateur : n'y mettre aucun secret.

# URL de l'API backend (sans slash final). Sans valeur, l'API de production est utilisée.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
